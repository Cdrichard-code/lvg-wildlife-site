---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
const SITE = 'https://lvgwildlife.com';
const { title, description, path, ogTitle, ogDescription, ld, current = '', robots = 'index,follow,max-image-preview:large', mcta = null, bodyStyle = '' } = Astro.props;
const url = SITE + path;
---
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">

<title>{title}</title>
<meta name="description" content={description}>
<link rel="canonical" href={url}>
<meta name="robots" content={robots}>
<meta name="geo.region" content="US-TX">

<meta property="og:type" content="website">
<meta property="og:site_name" content="LVG Wildlife Solutions">
<meta property="og:url" content={url}>
<meta property="og:title" content={ogTitle}>
<meta property="og:description" content={ogDescription}>
<meta property="og:image" content={SITE + '/og.png'}>
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content={ogTitle}>
<meta name="twitter:description" content={ogDescription}>
<meta name="twitter:image" content={SITE + '/og.png'}>

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;500;600;700;800&family=Spectral:ital,wght@0,300;0,400;0,500;0,600;1,300&display=swap" rel="stylesheet">
<meta name="theme-color" content="#20231D">
<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png">
<link rel="icon" type="image/png" sizes="192x192" href="/favicon-192.png">
<link rel="apple-touch-icon" href="/apple-touch-icon.png">
<link rel="stylesheet" href="/styles.css">
{bodyStyle && <style is:inline set:html={bodyStyle}></style>}
<script type="application/ld+json" is:inline set:html={JSON.stringify(ld, null, 1)}></script>
</head>
<body>
<Header current={current} />
<slot />
<Footer />
{mcta && (
<div class="mcta">
  <div class="lab"><b>{mcta.title}</b>{mcta.line}</div>
  <a class='btn p' href={mcta.href}>{mcta.label}</a>
</div>
)}
</body>
</html>
