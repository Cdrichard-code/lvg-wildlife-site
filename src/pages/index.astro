---
import Base from '../layouts/Base.astro';
import InquiryForm from '../components/InquiryForm.astro';
import { faqGroups, stripTags } from '../data/faqs.js';
import { SITE } from '../data/site.js';

const pick = [
  "What's included in your wildlife management plan?",
  'Who does the work in the plan, me or you?',
  'How do I switch from an ag exemption to a wildlife exemption in Texas?',
  'How small a property is worth managing?',
  'Why am I seeing deer at dark but not during daylight?',
  'How much does a wildlife management plan cost?',
];
const all = faqGroups.flatMap((g) => g.items);
const homeFaq = pick.map((q) => all.find((x) => x.q === q)).filter(Boolean);

const ld = { '@context': 'https://schema.org', '@graph': [
  {
    '@type': 'ProfessionalService', '@id': SITE + '/#business',
    name: 'LVG Wildlife Solutions', alternateName: 'Land Value Group Wildlife Solutions',
    description: 'Wildlife management plans, on-foot property assessments, annual reports, and whitetail habitat work for landowners in Texas and Oklahoma. Texas plans are prepared to file for the wildlife tax exemption.',
    url: SITE + '/', logo: SITE + '/favicon-192.png', image: SITE + '/og.png', priceRange: '$$',
    parentOrganization: { '@type': 'Organization', name: 'Land Value Group', url: 'https://landvaluegroup.com/' },
    areaServed: [{ '@type': 'State', name: 'Texas' }, { '@type': 'State', name: 'Oklahoma' }],
    knowsAbout: ['Wildlife management plans', 'Texas wildlife tax exemption', '1-d-1 open-space wildlife management valuation', 'Whitetail deer habitat management', 'Food plots', 'Wildlife property assessment', 'Trail camera surveys and census counts', 'Brush management', 'Nest boxes and wood duck boxes', 'Feral hog control'],
    hasOfferCatalog: { '@type': 'OfferCatalog', name: 'Services', itemListElement: [
      ['Property assessment', '/property-assessment'], ['Wildlife management plans', '/wildlife-management-plans'],
      ['Annual reports and yearly help', '/annual-reports'], ['Habitat work', '/habitat-work'],
    ].map(([n, p]) => ({ '@type': 'Offer', itemOffered: { '@type': 'Service', name: n, url: SITE + p } })) },
  },
  { '@type': 'WebSite', '@id': SITE + '/#website', url: SITE + '/', name: 'LVG Wildlife Solutions', publisher: { '@id': SITE + '/#business' } },
] };

const services = [
  ['/property-assessment', '01', 'Property assessment', 'We walk every acre and tell you straight what is working, what is holding the place back, and what to fix first.'],
  ['/wildlife-management-plans', '02', 'Wildlife management plans', 'The full game plan for your land, mapped and on a calendar. In Texas, ready to file for the wildlife tax exemption.'],
  ['/annual-reports', '03', 'Annual reports and yearly help', 'A yearly visit, a look at what changed, and your annual report handled, so the plan keeps working.'],
  ['/habitat-work', '04', 'Habitat work', 'Food plots, brush work, nest boxes, and the first year of practices, done with you or for you.'],
];
---
<Base
  title="LVG Wildlife Solutions | Wildlife Management in Texas & Oklahoma"
  description="Wildlife management plans and on-foot property assessments for Texas and Oklahoma landowners. Better habitat, better hunting, and Texas plans ready to file for the wildlife exemption."
  path="/"
  ogTitle="LVG Wildlife Solutions | Wildlife Management Plans in Texas and Oklahoma"
  ogDescription="We walk your land and build the plan to make it better. Better habitat, better hunting, and in Texas, ready to file for the wildlife exemption."
  current="home"
  ld={ld}
  mcta={{ title: 'Property assessment', line: 'Texas and Oklahoma', href: '/contact', label: 'Get in touch' }}
>
<!-- ===================== HERO ===================== -->
<div class="hero topo-gold deep">
  <div class="wrap">
    <div class="idx reveal"><i></i><s></s><b>WILDLIFE MANAGEMENT &middot; TEXAS AND OKLAHOMA</b></div>
    <h1 class="reveal">Wildlife management plans, built by walking your land.</h1>
    <p class="sub reveal d1">We put boots on every acre, figure out what your property is short of, and hand you a plan to fix it: what to do, where, when, and who does it. Whitetail are our specialty. In Texas, the same plan is ready to file for the wildlife tax exemption, so the work that improves your land can also qualify it.</p>
    <div class="acts reveal d2">
      <a class='btn p' href='/contact'>Request a property assessment</a>
      <a class="btn s" href="#how-it-works">How it works</a>
    </div>
    <aside class="seven reveal d2" aria-label="What's in your plan">
      <p class="k">WHAT'S IN YOUR PLAN</p>
      <ol>
        <li><b>1</b>On-foot walk of your property</li>
        <li><b>2</b>Habitat report and maps</li>
        <li><b>3</b>What to do, and where</li>
        <li><b>4</b>Who does each job: you or us</li>
        <li><b>5</b>Calendar from 90 days to year five</li>
        <li><b>6</b>Record kit for your annual report</li>
        <li><b>7</b>Texas wildlife exemption filing help</li>
      </ol>
      <p class="n">Written for your property after we've walked it. No templates.</p>
    </aside>
    <div class="meta reveal d3">
      <div><b>ON FOOT</b><span>Every plan starts with us on your ground, not a satellite photo</span></div>
      <div><b>STRAIGHT TALK</b><span>What we saw, what we think it means, and how sure we are</span></div>
      <div><b>TAX READY</b><span>Texas plans prepared to file for the wildlife exemption</span></div>
    </div>
  </div>
</div>

<!-- ===================== SERVICES ===================== -->
<section id="services" class="topo-ink shift-1 seam">
  <div class="wrap">
    <div class="shead">
      <div class="idx"><i></i><s></s><b>SERVICES</b></div>
      <h2>Wildlife management services, start to finish</h2>
      <p class="sd">One team from the first walk to the fifth year. Pick what you need; skip what you don't.</p>
    </div>
    <div class="svcgrid four">
      {services.map(([href, n, title, text]) => (
        <a class="svclink" href={href}><span class="tag">{n}</span><h3>{title}</h3><p>{text}</p><span class="more">Learn more</span></a>
      ))}
    </div>
  </div>
</section>

<!-- ===================== HOW IT WORKS ===================== -->
<section id="how-it-works" class="topo-ink shift-2 seam deepstone">
  <div class="wrap">
    <div class="shead">
      <div class="idx"><i></i><s></s><b>HOW IT WORKS</b></div>
      <h2>From first call to a plan you'll actually use</h2>
      <p class="sd">Six steps. You can stop after any one of them, no hard feelings.</p>
    </div>
    <ol class="steps">
      <li><b>Tell us about your land</b><p>The short form: county, rough acreage, how it's taxed now, and what you want out of it. A real person reads every one.</p></li>
      <li><b>Intro call and intake</b><p>We talk through your property and your goals, then send a short intake form so our time on the ground counts.</p></li>
      <li><b>Pick what fits</b><p>An assessment on its own, a full management plan, or a plan with yearly help after it. We'll tell you what we'd do; you decide.</p></li>
      <li><b>We walk your property</b><p>Boundary to boundary, on foot. Habitat, deer sign, water, terrain, and which ground you can actually manage.</p></li>
      <li><b>Your plan, ready to file</b><p>Report, maps, and the written plan, then a call to walk through it. In Texas, we prepare it for the wildlife exemption and help you file with your county.</p></li>
      <li><b>Year after year</b><p>A yearly visit, a look at what changed, and the annual report handled, so the plan keeps working and your records stay ready.</p></li>
    </ol>
  </div>
</section>

<!-- ===================== EXAMPLES ===================== -->
<section id="examples" class="topo-ink shift-1 seam">
  <div class="wrap">
    <div class="shead">
      <div class="idx"><i></i><s></s><b>WHAT YOU GET</b></div>
      <h2>Maps, findings and a calendar you can run with</h2>
      <p class="sd">Not a binder that sits on a shelf. These come from an example property, for illustration.</p>
    </div>
    <div class="gallery">
      <a href="/wildlife-management-plans"><figure class="exfig"><img src="/img/examples/example-map-plan.webp" alt="Example wildlife management plan map with food plots, stands, trail cameras, nest boxes and trails" width="1800" height="1511" loading="lazy"><figcaption>Every practice, mapped</figcaption></figure></a>
      <a href="/property-assessment"><figure class="exfig"><img src="/img/examples/example-findings.webp" alt="Example property assessment findings: what we observed, our read with a confidence level, and what to do" width="1800" height="771" loading="lazy"><figcaption>Findings you can act on</figcaption></figure></a>
      <a href="/annual-reports"><figure class="exfig"><img src="/img/examples/example-calendar.webp" alt="Example wildlife management calendar by month" width="1800" height="1044" loading="lazy"><figcaption>Your year, month by month</figcaption></figure></a>
    </div>
  </div>
</section>

<!-- ===================== TEXAS TAX ===================== -->
<section id="wildlife-tax-exemption" class="dark topo-gold shift-2 band">
  <div class="wrap cta">
    <div>
      <div class="idx"><i></i><s></s><b>FOR TEXAS LANDOWNERS</b></div>
      <h2>Better habitat and the wildlife exemption come from the same work</h2>
      <p>Texas lets land that already has an ag exemption keep that valuation by being managed for wildlife instead of cattle or hay. It takes a written plan and three of seven practices a year. We write the plan around the wildlife on your land, prepare it to file, and help you keep the records that back it up.</p>
    </div>
    <div class="acts">
      <a class='btn p' href='/wildlife-tax-valuation'>How the wildlife exemption works</a>
    </div>
  </div>
</section>

<!-- ===================== WHY US ===================== -->
<section id="approach" class="topo-ink shift-3 seam deepstone">
  <div class="wrap">
    <div class="shead">
      <div class="idx"><i></i><s></s><b>HOW WE WORK</b></div>
      <h2>No guessing, no templates, no fluff</h2>
      <p class="sd">What you can expect from us on every property.</p>
    </div>
    <div class="prin light">
      <div><h3>We tell you what we saw, and what we think it means</h3><p>A rub line is a fact. A bedding area is our read. We keep them apart, and every conclusion comes with how sure we are, so you know what to act on now and what to check with cameras first.</p></div>
      <div><h3>We only recommend work you can actually do</h3><p>Leased ground, easements, and restricted acres change the rules. We map what you control before we recommend anything, and we won't put a practice in your plan that you're not allowed to carry out.</p></div>
      <div><h3>We don't prescribe before we have data</h3><p>Seed rates without a soil test and harvest numbers without camera data are guesses. If your plan needs information you don't have yet, we'll say so and tell you how to get it.</p></div>
      <div><h3>We write plans you'll keep up with</h3><p>Three practices you'll actually do beat seven that look good on paper and fall apart by spring. Every job is sized to your time, your equipment, and your budget.</p></div>
    </div>
    <p style="margin-top:1.6rem"><a href="/about">More about us</a></p>
  </div>
</section>

<!-- ===================== SERVICE AREA ===================== -->
<section class="dark well topo-gold shift-1" id="service-area">
  <div class="wrap">
    <div class="shead">
      <div class="idx"><i></i><s></s><b>SERVICE AREA</b></div>
      <h2>Where we work: North and East Texas, Cross Timbers, and southern Oklahoma</h2>
      <p class="sd">Blackland clay, sandy loam, post oak, pine. We know how each one grows, holds deer, and responds to work, so your plan fits your dirt.</p>
    </div>
    <ul class="regions">
      <li style="--rc:var(--oak)"><b>Blackland Prairie and Post Oak Savannah</b><span>Heavy clay soils, post oak woodland, eastern red cedar encroachment</span><em>Hunt, Rains, Van Zandt, Kaufman, Collin, Fannin, Hopkins counties</em></li>
      <li style="--rc:var(--bluestem)"><b>Cross Timbers</b><span>Post oak and blackjack mixed with improved pasture and native grass</span><em>Parker, Wise, Jack, Palo Pinto, Erath counties</em></li>
      <li style="--rc:var(--prairie)"><b>Pineywoods and East Texas</b><span>Pine and hardwood, bottomland drainages, managed timber</span><em>Wood, Henderson, Smith, Cherokee, Anderson counties</em></li>
      <li style="--rc:var(--stone)"><b>Southern Oklahoma</b><span>Mixed hardwood, native grass, and agricultural edge</span><em>Bryan, Love, Marshall, Johnston, Atoka counties</em></li>
    </ul>
    <p class="note">Outside these counties? Ask. We'll tell you honestly whether we're the right fit. The wildlife tax exemption applies to Texas properties.</p>
  </div>
</section>

<!-- ===================== FAQ ===================== -->
<section id="questions" class="topo-ink shift-2 seam">
  <div class="wrap">
    <div class="shead">
      <div class="idx"><i></i><s></s><b>QUESTIONS</b></div>
      <h2>Questions landowners ask us most</h2>
      <p class="sd">Straight answers. <a href="/faq">See all of them</a>, or search for yours.</p>
    </div>
    <div class="faq"><div class="faqgroup"><div class="acc">
      {homeFaq.map((x, i) => <details open={i === 0}><summary>{x.q}</summary><div class="a"><p set:html={x.a} /></div></details>)}
    </div></div></div>
  </div>
</section>

<!-- ===================== CONTACT ===================== -->
<section class="contact dark topo-gold shift-3" id="contact">
  <div class="wrap">
    <div class="shead">
      <div class="idx"><i></i><s></s><b>GET IN TOUCH</b></div>
      <h2>Let's take a look at your land</h2>
      <p class="sd">Tell us about your property and what you want from it. We'll get back to you within a couple of days.</p>
    </div>
    <div class="cgrid">
      <div class="cinfo">
        <p>You don't need anything figured out before you reach out. Most folks call because something isn't working and they're not sure why, or because they want a plan they can file for the wildlife exemption. Either one is the right time.</p>
        <p>We treat every property like a partnership. Your goals set the direction. Our job is finding what your land can do and showing you the way there.</p>
        <dl>
          <div><dt>Service area</dt><dd>Texas and Oklahoma</dd></div>
          <div><dt>Response time</dt><dd>Within a couple of days</dd></div>
        </dl>
      </div>
      <InquiryForm source="home page" />
    </div>
  </div>
</section>
</Base>
