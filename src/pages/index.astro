---
import Base from '../layouts/Base.astro';
import InquiryForm from '../components/InquiryForm.astro';
import Estimator from '../components/Estimator.astro';
import { faqGroups, stripTags } from '../data/faqs.js';
import { SITE, CONTACT } from '../data/site.js';

const pick = [
  "What's included in your wildlife management plan?",
  'Who does the work in the plan, me or you?',
  'How do I switch from an ag exemption to a wildlife exemption in Texas?',
  'How small a property is worth managing?',
  'Why am I seeing deer at dark but not during daylight?',
  'How much does a wildlife management plan cost?',
];
const all = faqGroups.flatMap((g) => g.items);
const homeFaq = pick.map((q) => all.find((x) => x.q === q)).filter(Boolean);

const ld = { '@context': 'https://schema.org', '@graph': [
  {
    '@type': 'ProfessionalService', '@id': SITE + '/#business',
    name: 'LVG Wildlife Solutions', alternateName: 'Land Value Group Wildlife Solutions',
    description: 'Wildlife management plans, on-foot property assessments, annual reports, and whitetail habitat work for Texas landowners. Plans are prepared to file for the wildlife tax exemption.',
    url: SITE + '/', logo: SITE + '/favicon-192.png', image: SITE + '/og.png', priceRange: '$$',
    parentOrganization: { '@type': 'Organization', name: 'Land Value Group', url: 'https://landvaluegroup.com/' },
    areaServed: { '@type': 'State', name: 'Texas' },
    ...(CONTACT.phone ? { telephone: CONTACT.phone } : {}), ...(CONTACT.email ? { email: CONTACT.email } : {}),
    knowsAbout: ['Wildlife management plans', 'Texas wildlife tax exemption', '1-d-1 open-space wildlife management valuation', 'Whitetail deer habitat management', 'Food plots', 'Wildlife property assessment', 'Trail camera surveys and census counts', 'Brush management', 'Nest boxes and wood duck boxes', 'Feral hog control'],
    hasOfferCatalog: { '@type': 'OfferCatalog', name: 'Services', itemListElement: [
      ['Property assessment', '/property-assessment'], ['Wildlife management plans', '/wildlife-management-plans'],
      ['Annual reports and yearly help', '/annual-reports'], ['Habitat work', '/habitat-work'],
    ].map(([n, p]) => ({ '@type': 'Offer', itemOffered: { '@type': 'Service', name: n, url: SITE + p } })) },
  },
  { '@type': 'WebSite', '@id': SITE + '/#website', url: SITE + '/', name: 'LVG Wildlife Solutions', publisher: { '@id': SITE + '/#business' } },
] };

const services = [
  ['/property-assessment', '01', 'Property assessment', 'We walk every acre and tell you straight what is working, what is holding the place back, and what to fix first.'],
  ['/wildlife-management-plans', '02', 'Wildlife management plans', 'The full game plan for your land, mapped and on a calendar. Ready to file for the wildlife tax exemption.'],
  ['/annual-reports', '03', 'Annual reports and yearly help', 'A yearly visit, a look at what changed, and your annual report handled, so the plan keeps working.'],
  ['/habitat-work', '04', 'Habitat work', 'Food plots, brush work, nest boxes, and the first year of practices, done with you or for you.'],
];

const situations = [
  ['You just bought land with an ag exemption', 'A new owner has to re-file before May 1. If you are not running cattle or cutting hay, a wildlife plan is often the way to keep that valuation.', '/wildlife-tax-valuation', 'Texas wildlife exemption'],
  ['You see deer on camera, just not in daylight', 'Usually a bedding, food, or access problem, not a deer problem. We walk it and tell you which one.', '/property-assessment', 'Property assessment'],
  ['You keep cows or hay just for the tax break', 'Land with an ag valuation can switch to wildlife management instead. Same tax, no grazing lease or hay contract required.', '/wildlife-tax-valuation', 'How switching works'],
  ['You already have a plan, and the paperwork', 'Annual reports, plan check-ups, and records that hold up, even if someone else wrote your plan.', '/annual-reports', 'Annual reports'],
  ['You want food plots that actually get used', 'Planted where deer feel safe using them, matched to your soil, with access you can hunt without blowing them out.', '/habitat-work', 'Habitat work'],
  ['You need brush cleared or ground opened up', 'Land Value Group, our parent company, handles clearing, mulching, and site work. We tell them what the wildlife needs.', '/land-clearing', 'Land clearing'],
];
const species = [
  ['Whitetail deer', 'Bedding cover, food through the year, quiet access, and harvest records. Where we spend most of our time.'],
  ['Ducks and wood ducks', 'Ponds, flats, and wood duck boxes placed where birds will use them.'],
  ['Turkey', 'Roost trees, nesting cover, and open ground for bugging poults.'],
  ['Quail, songbirds and pollinators', 'Native grass, forbs, nest boxes, and mowing timed around nesting.'],
  ['Feral hogs', 'Trapping and control as part of the plan, so they stop eating what you plant.'],
];
const knows = [
  ['Selling land doesn\'t pass the ag valuation along.', 'When ownership changes, the new owner files a new application with the county before May 1. Miss it and the land can lose its special valuation.', '/wildlife-tax-valuation', 'What new owners need to do'],
  ['Switching from cattle to wildlife doesn\'t raise your taxes.', 'Wildlife valuation is taxed the same as ag. What changes is the work: wildlife practices instead of a grazing lease or hay.', '/faq?q=switching', 'How the switch works'],
  ['Losing the valuation can cost three years of back taxes.', 'If land falls out of qualifying use, Texas charges a rollback tax covering the previous three years. Good records are cheap insurance.', '/faq?q=rollback', 'What the rollback is'],
  ['Your county can ask for proof, year after year.', 'More appraisal districts are asking for annual reports. Logs, dated photos and receipts kept as you go make it painless.', '/annual-reports', 'Annual reports'],
  ['Deer at night only? It\'s rarely a deer problem.', 'It\'s usually bedding with no reason to move in daylight, or an access route that pushes deer out before you ever sit down.', '/property-assessment', 'Find out what\'s going on'],
  ['Where a food plot goes matters more than what\'s in it.', 'A plot in the wrong spot relative to bedding and access can make a property harder to hunt, not easier.', '/habitat-work', 'Food plots done right'],
];
const benefits = [
  ['We walk every acre', 'Every report and plan starts with boots on your ground, not an aerial photo and a template.'],
  ['You\'ll know exactly what to do', 'Every job has a where, a when, and a who: you, or us if you\'d rather. No guessing what comes next.'],
  ['Straight talk, every time', 'What we saw, what we think it means, and how sure we are. Including the answers that don\'t make us money.'],
  ['Sized to your life', 'Plans built around your time, your equipment and your budget, so they actually get done.'],
  ['Texas filing, handled with you', 'Your plan is prepared to file for the wildlife exemption, and we help you file it with your county.'],
  ['We stick around', 'Yearly visits, annual reports and a record of how your land changes over time. Partners, not a one-time sale.'],
];
import { counties, regions, countyPath } from '../data/counties.js';
---
<Base
  title="LVG Wildlife Solutions | Wildlife Management Plans in North & East Texas"
  description="Wildlife management plans and on-foot property assessments for North and East Texas landowners. Better habitat, better hunting, and plans ready to file for the wildlife exemption."
  path="/"
  ogTitle="LVG Wildlife Solutions | Wildlife Management Plans in Texas"
  ogDescription="We walk your land and build the plan to make it better. Better habitat, better hunting, and a plan ready to file for the wildlife exemption."
  current="home"
  ld={ld}
  mcta={{ title: 'Property assessment', line: 'North and East Texas', href: '/contact', label: 'Get in touch' }}
>
<!-- ===================== HERO ===================== -->
<div class="hero topo-gold deep">
  <div class="wrap">
    <div class="idx reveal"><i></i><s></s><b>WILDLIFE MANAGEMENT &middot; NORTH AND EAST TEXAS</b></div>
    <h1 class="reveal">Wildlife management plans, built by walking your land.</h1>
    <p class="sub reveal d1">We put boots on every acre, figure out what your property is short of, and hand you a plan to fix it: what to do, where, when, and who does it. Whitetail are our specialty. The same plan is ready to file for the wildlife tax exemption, so the work that improves your land can also qualify it.</p>
    <div class="acts reveal d2">
      <a class='btn p' href='/contact'>Request a property assessment</a>
      <a class="btn s" href="#how-it-works">How it works</a>
    </div>
    <ul class="trust reveal d2"><li>Boots-on-the-ground assessments</li><li>Interactive online reports</li><li>Whitetail and habitat specialists</li></ul>
    <aside class="seven reveal d2" aria-label="What's in your plan">
      <p class="k">WHAT'S IN YOUR PLAN</p>
      <ol>
        <li><b>1</b>On-foot walk of your property</li>
        <li><b>2</b>Habitat report and maps</li>
        <li><b>3</b>What to do, and where</li>
        <li><b>4</b>Who does each job: you or us</li>
        <li><b>5</b>Calendar from 90 days to year five</li>
        <li><b>6</b>Record kit for your annual report</li>
        <li><b>7</b>Texas wildlife exemption filing help</li>
      </ol>
      <p class="n">Written for your property after we've walked it. No templates.</p>
    </aside>
    <div class="meta reveal d3">
      <div><b>ON FOOT</b><span>Every plan starts with us on your ground, not a satellite photo</span></div>
      <div><b>STRAIGHT TALK</b><span>What we saw, what we think it means, and how sure we are</span></div>
      <div><b>TAX READY</b><span>Texas plans prepared to file for the wildlife exemption</span></div>
    </div>
  </div>
</div>

<!-- ===================== WHO WE HELP ===================== -->
<section id="who-we-help" class="topo-ink shift-1 seam">
  <div class="wrap">
    <div class="shead">
      <div class="idx"><i></i><s></s><b>BUILT FOR YOUR SITUATION</b></div>
      <h2>Where most landowners start with us</h2>
      <p class="sd">Pick the one that sounds like you.</p>
    </div>
    <div class="sitcards">
      {situations.map(([h, p, href, label]) => (
        <a class="sitcard" href={href}><h3>{h}</h3><p>{p}</p><span class="more">{label}</span></a>
      ))}
    </div>
  </div>
</section>

<!-- ===================== SERVICES ===================== -->
<section id="services" class="topo-ink shift-2 seam deepstone">
  <div class="wrap">
    <div class="shead">
      <div class="idx"><i></i><s></s><b>FROM FIRST WALK TO EVERY YEAR AFTER</b></div>
      <h2>Wildlife management services, start to finish</h2>
      <p class="sd">One team from the first walk to the fifth year. Pick what you need; skip what you don't.</p>
    </div>

    <div class="frow">
      <a class="frow-img" href="/property-assessment"><img src="/img/examples/example-findings.webp" alt="Example property assessment findings with a confidence level" width="1800" height="771" loading="lazy"></a>
      <div class="frow-txt">
        <span class="tag">01 &middot; START HERE</span>
        <h3>Property assessment</h3>
        <p>We walk your property boundary to boundary and tell you straight what is working, what is holding it back, and what to fix first. You get an online report with maps and photos, a PDF, and a call to go through it.</p>
        <ul class="checks"><li>Habitat, deer sign, water and terrain mapped</li><li>Every finding with how sure we are</li><li>Ranked priorities, including the free ones</li></ul>
        <a class="btn s2" href="/property-assessment">About the assessment</a>
      </div>
    </div>

    <div class="frow flip">
      <a class="frow-img" href="/wildlife-management-plans"><img src="/img/examples/example-map-plan.webp" alt="Example wildlife management plan map with food plots, stands, cameras and nest boxes" width="1800" height="1511" loading="lazy"></a>
      <div class="frow-txt">
        <span class="tag">02 &middot; THE PLAN</span>
        <h3>Wildlife management plans</h3>
        <p>The full game plan for your land: what to do, where, when, and who does it. Every practice mapped, a calendar from the next 90 days to year five, and costs for doing it yourself or having us do it. Ready to file for the wildlife exemption.</p>
        <ul class="checks"><li>Food, cover and water work, mapped and sequenced</li><li>A record kit for your annual report</li><li>Filing help with your county appraisal district</li></ul>
        <a class="btn s2" href="/wildlife-management-plans">About management plans</a>
      </div>
    </div>

    <div class="frow">
      <a class="frow-img" href="/annual-reports"><img src="/img/examples/example-yearly-record.webp" alt="Example yearly record of practices, photos and receipts for the annual report" width="1800" height="990" loading="lazy"></a>
      <div class="frow-txt">
        <span class="tag">03 &middot; EVERY YEAR</span>
        <h3>Annual reports and yearly help</h3>
        <p>A plan is something you repeat every year, and the annual report is how you show it. We handle the report, or come back once a year, look at what changed, and write it up.</p>
        <ul class="checks"><li>Annual report prepared and filed with you</li><li>A yearly visit and year-in-review report</li><li>Works with any plan, ours or someone else's</li></ul>
        <a class="btn s2" href="/annual-reports">About annual reports</a>
      </div>
    </div>

    <div class="frow flip">
      <a class="frow-img" href="/habitat-work"><img src="/img/examples/example-map-deer-sign.webp" alt="Example deer sign map with likely bedding, trails, rubs and scrapes" width="1800" height="1550" loading="lazy"></a>
      <div class="frow-txt">
        <span class="tag">04 &middot; ON THE GROUND</span>
        <h3>Habitat work</h3>
        <p>Food plots, brush and old-field work, nest boxes, camera surveys and stand placement. Done with you or for you, and recorded for your annual report.</p>
        <ul class="checks"><li>Plots planted where deer will use them</li><li>Cover and browse where it's missing</li><li>Quoted job by job, after we've seen the ground</li></ul>
        <a class="btn s2" href="/habitat-work">About habitat work</a>
      </div>
    </div>
  </div>
</section>

<!-- ===================== DID YOU KNOW ===================== -->
<section id="good-to-know" class="dark well topo-gold shift-3">
  <div class="wrap">
    <div class="shead">
      <div class="idx"><i></i><s></s><b>WHAT MOST LANDOWNERS NEVER HEAR</b></div>
      <h2>Things most landowners find out too late</h2>
      <p class="sd">The stuff we explain on almost every first call.</p>
    </div>
    <div class="knows">
      {knows.map(([h, p, href, label]) => (
        <a class="know" href={href}><h3>{h}</h3><p>{p}</p><span class="more">{label}</span></a>
      ))}
    </div>
  </div>
</section>

<!-- ===================== TEXAS TAX ===================== -->
<section id="wildlife-tax-exemption" class="topo-ink shift-1 seam deepstone">
  <div class="wrap twocol">
    <div>
      <div class="idx"><i></i><s></s><b>BETTER LAND, LOWER TAXES</b></div>
      <h2 class="h2s" style="font-size:clamp(1.7rem,3.2vw,2.6rem)">Better habitat and the wildlife exemption come from the same work</h2>
      <div class="prose">
        <p>Texas lets land that already has an ag exemption keep that valuation by being managed for native wildlife instead of cattle or hay. It takes a written plan and at least three of seven practices a year: habitat control, erosion control, predator control, supplemental water, supplemental food, shelter, and census counts.</p>
        <p>Most good habitat work already fits in there. We write the plan around the wildlife on your land, prepare it to file, and help you keep the records that back it up.</p>
      </div>
      <dl class="facts light">
        <div><dt>3 of 7</dt><dd>Wildlife practices carried out every year</dd></div>
        <div><dt>Ag first</dt><dd>The land must already have an ag or timber valuation</dd></div>
        <div><dt>May 1</dt><dd>File the plan and application with your county before this date</dd></div>
      </dl>
      <div style="display:flex;flex-wrap:wrap;gap:.7rem;margin-top:1.8rem">
        <a class="btn p" href="/wildlife-tax-valuation">How the wildlife exemption works</a>
        <a class="btn s2" href="/faq?q=exemption">Exemption questions</a>
      </div>
    </div>
    <div>
      <p class="estlabel">Pick your county and see a rough number for your land.</p>
      <Estimator p="home" />
      <p class="estlink"><a href="/tax-savings-calculator">Open the full calculator, with what it means and what to ask</a></p>
    </div>
  </div>
</section>

<!-- ===================== HOW IT WORKS ===================== -->
<section id="how-it-works" class="topo-ink shift-2 seam">
  <div class="wrap">
    <div class="shead">
      <div class="idx"><i></i><s></s><b>A CLEAR PROCESS, START TO FINISH</b></div>
      <h2>From first call to a plan you'll actually use</h2>
      <p class="sd">Six steps. You can stop after any one of them, no hard feelings.</p>
    </div>
    <ol class="steps">
      <li><b>Tell us about your land</b><p>The short form: county, rough acreage, how it's taxed now, and what you want out of it. A real person reads every one.</p></li>
      <li><b>Intro call and intake</b><p>We talk through your property and your goals, then send a short intake form so our time on the ground counts.</p></li>
      <li><b>Pick what fits</b><p>An assessment on its own, a full management plan, or a plan with yearly help after it. We'll tell you what we'd do; you decide.</p></li>
      <li><b>We walk your property</b><p>Boundary to boundary, on foot. Habitat, deer sign, water, terrain, and which ground you can actually manage.</p></li>
      <li><b>Your plan, ready to file</b><p>Report, maps, and the written plan, then a call to walk through it. We prepare it for the wildlife exemption and help you file with your county.</p></li>
      <li><b>Year after year</b><p>A yearly visit, a look at what changed, and the annual report handled, so the plan keeps working and your records stay ready.</p></li>
    </ol>
  </div>
</section>

<!-- ===================== WHY US ===================== -->
<section id="why-us" class="dark topo-gold shift-2">
  <div class="wrap">
    <div class="shead">
      <div class="idx"><i></i><s></s><b>WHY LANDOWNERS CHOOSE US</b></div>
      <h2>No guessing, no templates, no fluff</h2>
      <p class="sd">What you get on every property, whether it's 40 acres or 400.</p>
    </div>
    <div class="bens">
      {benefits.map(([h, p], i) => <div><span>{String(i + 1).padStart(2, '0')}</span><h3>{h}</h3><p>{p}</p></div>)}
    </div>
    <div style="display:flex;flex-wrap:wrap;gap:.7rem;margin-top:2.2rem">
      <a class="btn p" href="/contact">Request a property assessment</a>
      <a class="btn s" href="/about">More about us</a>
    </div>
  </div>
</section>

<!-- ===================== SPECIES ===================== -->
<section id="species" class="topo-ink shift-1 seam deepstone">
  <div class="wrap">
    <div class="shead">
      <div class="idx"><i></i><s></s><b>WHITETAIL FIRST, WHOLE-PROPERTY THINKING</b></div>
      <h2>Whitetail first, but not whitetail only</h2>
      <p class="sd">A good plan names more than one species, and it should. Here's what we plan around.</p>
    </div>
    <div class="spec">
      {species.map(([h, p]) => <div><h3>{h}</h3><p>{p}</p></div>)}
    </div>
    <p style="margin-top:1.6rem"><a href="/habitat-work">See the habitat work behind it</a></p>
  </div>
</section>

<!-- ===================== SERVICE AREA ===================== -->
<section class="dark well topo-gold shift-1" id="service-area">
  <div class="wrap">
    <div class="shead">
      <div class="idx"><i></i><s></s><b>LOCAL GROUND, LOCAL KNOWLEDGE</b></div>
      <h2>Where we work: North and East Texas</h2>
      <p class="sd">Blackland clay, sandy loam, post oak, pine. We know how each one grows, holds deer, and responds to work, so your plan fits your dirt.</p>
    </div>
    <ul class="regions">
      {regions.map((r, i) => (
        <li style={`--rc:var(${['--oak','--bluestem','--prairie'][i]})`}><b>{r.name}</b><span>{r.line}</span>
          <em>{counties.filter((c) => c.region === r.key).map((c, j) => <Fragment>{j > 0 && ', '}<a href={countyPath(c)}>{c.name}</a></Fragment>)} counties</em></li>
      ))}
    </ul>
    <p style="margin-top:1.5rem"><a class="btn s" href="/service-area">See every county we serve</a></p>
    <p class="note">Outside these counties? Ask. We'll tell you honestly whether we're the right fit.</p>
  </div>
</section>

<!-- ===================== FAMILY ===================== -->
<section id="family" class="topo-ink shift-3 seam">
  <div class="wrap">
    <div class="duo">
      <a class="duocard" href="/land-clearing">
        <span class="tag">LAND VALUE GROUP</span>
        <h3>Need ground cleared or opened up?</h3>
        <p>Our parent company, Land Value Group, does land clearing, forestry mulching, trail cutting and site work across Texas. When your plan calls for it, they can do it.</p>
        <span class="more">Land clearing and mulching</span>
      </a>
      <a class="duocard" href="/partners">
        <span class="tag">REALTORS AND LAND BROKERS</span>
        <h3>Selling rural land?</h3>
        <p>New owners often inherit an ag valuation they don't know how to keep. Send them our way for an assessment and a plan they can file.</p>
        <span class="more">Refer a buyer or seller</span>
      </a>
    </div>
  </div>
</section>

<!-- ===================== FAQ ===================== -->
<section id="questions" class="topo-ink shift-2 seam deepstone">
  <div class="wrap">
    <div class="shead">
      <div class="idx"><i></i><s></s><b>STRAIGHT ANSWERS</b></div>
      <h2>Questions landowners ask us most</h2>
      <p class="sd">Straight answers. <a href="/faq">See all of them</a>, or search for yours.</p>
    </div>
    <div class="faq"><div class="faqgroup"><div class="acc">
      {homeFaq.map((x, i) => <details open={i === 0}><summary>{x.q}</summary><div class="a"><p set:html={x.a} /></div></details>)}
    </div></div></div>
  </div>
</section>

<!-- ===================== CONTACT ===================== -->
<section class="contact dark topo-gold shift-3" id="contact">
  <div class="wrap">
    <div class="shead">
      <div class="idx"><i></i><s></s><b>START WITH YOUR LAND</b></div>
      <h2>Let's take a look at your land</h2>
      <p class="sd">Tell us about your property and what you want from it. We'll get back to you within a couple of days.</p>
    </div>
    <div class="cgrid">
      <div class="cinfo">
        <p>You don't need anything figured out before you reach out. Most folks call because something isn't working and they're not sure why, or because they want a plan they can file for the wildlife exemption. Either one is the right time.</p>
        <p>We treat every property like a partnership. Your goals set the direction. Our job is finding what your land can do and showing you the way there.</p>
        <dl>
          <div><dt>Service area</dt><dd>North and East Texas</dd></div>
          <div><dt>Response time</dt><dd>Within a couple of days</dd></div>
        </dl>
      </div>
      <InquiryForm source="home page" />
    </div>
  </div>
</section>
</Base>
