---
import Base from '../layouts/Base.astro';
const ld = {
 "@context": "https://schema.org",
 "@type": "WebPage",
 "name": "Thank you",
 "url": "https://lvgwildlife.com/thanks"
};
---
<Base
  title={"Thank you | LVG Wildlife Solutions"}
  description={"Your inquiry has been received. We will get back to you within a couple of days."}
  path="/thanks"
  ogTitle={"Thank you | LVG Wildlife Solutions"}
  ogDescription={"Your inquiry has been received."}
  robots="noindex,follow"
  current="contact"
  ld={ld}
  mcta={null}
  bodyStyle="body{background:var(--soil);padding-bottom:0}"
>
<section class="dark topo-gold deep" style="min-height:70vh;display:flex;align-items:center">
  <div class="wrap">
    <div class="idx"><i></i><s></s><b>RECEIVED</b></div>
    <h1 style="font-size:clamp(2rem,5.4vw,3.4rem);max-width:24ch;font-weight:800">Thank you. We have your note.</h1>
    <div class="prose" style="margin-top:1.4rem">
      <p>We will get back to you within a couple of days, usually sooner.</p>
      <p>Nothing else is needed from you right now. When we do talk, it helps if you can tell us roughly where your property boundaries sit and whether any of the acreage is leased rather than owned.</p>
    </div>
    <div style="display:flex;flex-wrap:wrap;gap:.7rem;margin-top:2.2rem">
      <a class='btn p' href='/'>Back to the site</a>
      <a class='btn s' href='/#approach'>How we work</a>
    </div>
  </div>
</section>
</Base>
