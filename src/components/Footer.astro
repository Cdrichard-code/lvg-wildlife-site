---
import { counties, countyPath } from '../data/counties.js';
import { CONTACT } from '../data/site.js';
---
<footer>
  <div class="wrap">
    <div class="top">
      <div>
        <div class="fmark"><img src="/logo-stacked.webp" alt="Land Value Group Wildlife Solutions" width="534" height="520" loading="lazy"></div>
        <p class="blurb">Wildlife and habitat management for landowners across Texas and Oklahoma. Property assessments, comprehensive management plans, and honest answers about what your land can become.</p>
        <div class="fcontact">
          <h4>Get in touch</h4>
          {CONTACT.phone && <p><a href={CONTACT.phoneHref}>{CONTACT.phone}</a></p>}
          {CONTACT.email && <p><a href={`mailto:${CONTACT.email}`}>{CONTACT.email}</a></p>}
          <p>North and East Texas and southern Oklahoma</p>
          <a class="btn p" href="/contact">Request an assessment</a>
        </div>
      </div>
      <div>
        <h4>Services</h4>
        <ul>
          <li><a href='/property-assessment'>Property assessment</a></li>
          <li><a href='/wildlife-management-plans'>Wildlife management plans</a></li>
          <li><a href='/annual-reports'>Annual reports and yearly help</a></li>
          <li><a href='/habitat-work'>Habitat work</a></li>
          <li><a href='/wildlife-tax-valuation'>Texas wildlife tax exemption</a></li>
        </ul>
      </div>
      <div>
        <h4>More</h4>
        <ul>
          <li><a href='/about'>About</a></li>
          <li><a href='/faq'>Common questions</a></li>
          <li><a href='/partners'>For realtors and land brokers</a></li>
          <li><a href='/land-clearing'>Land clearing</a></li>
          <li><a href='/contact'>Request an assessment</a></li>
        </ul>
      </div>
      <div>
        <h4>Counties we serve</h4>
        <ul class="cols2">
          {[...counties].sort((a, b) => a.name.localeCompare(b.name)).map((c) => <li><a href={countyPath(c)}>{c.name}</a></li>)}
          <li><a href='/service-area'>All counties</a></li>
        </ul>
      </div>
    </div>
    <div class="base">
      <span>Texas and Oklahoma</span>
      <span>A <a href="https://landvaluegroup.com/">Land Value Group</a> company</span>
      <span class="r">&copy; 2026 Land Value Group Wildlife Solutions</span>
      <a class="login" href="https://portal.lvgwildlife.com/" rel="nofollow"><svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="4" y="11" width="16" height="10" rx="2"/><path d="M8 11V7a4 4 0 0 1 8 0v4"/></svg>Portal Login</a>
    </div>
  </div>
</footer>
