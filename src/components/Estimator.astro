---
// Rough wildlife/ag valuation savings estimator. Works for any number of
// copies on a page: each form is wired up by class, not id.
const { p = 'e' } = Astro.props;
---
<form class="est" onsubmit="return false" data-est>
  <div class="row3">
    <div class="fld"><label for={p + '-acres'}>Acres</label><input id={p + '-acres'} data-acres type="number" min="1" step="1" inputmode="numeric" placeholder="100"></div>
    <div class="fld"><label for={p + '-value'}>Market value per acre ($)</label><input id={p + '-value'} data-value type="number" min="0" step="100" inputmode="numeric" placeholder="8000"><span class="hint">Your appraisal notice shows this.</span></div>
    <div class="fld"><label for={p + '-rate'}>Total tax rate (%)</label><input id={p + '-rate'} data-rate type="number" min="0" step="0.01" inputmode="decimal" value="1.6"><span class="hint">All taxing units combined.</span></div>
  </div>
  <div class="out" aria-live="polite">
    <p class="k">ROUGH YEARLY DIFFERENCE</p>
    <div class="big" data-out>Enter acres and value</div>
    <p data-note>Compared with being taxed at full market value.</p>
  </div>
  <p class="fine">*A broad estimate only, with no guarantee. We estimate the difference using a typical productivity value of about $150 an acre, then show a range 25% either side of it; actual values, rates, and qualification are set by your county appraisal district, and their numbers decide. This is not tax advice.</p>
</form>
<script is:inline>
(function(){
  function nice(x,up){var st=x>=2000?500:x>=500?100:50;return (up?Math.ceil(x/st):Math.floor(x/st))*st;}
  function money(x){return '$'+Math.max(0,x).toLocaleString('en-US');}
  document.querySelectorAll('form[data-est]:not([data-ready])').forEach(function(f){
    f.setAttribute('data-ready','');
    var a=f.querySelector('[data-acres]'),v=f.querySelector('[data-value]'),r=f.querySelector('[data-rate]'),o=f.querySelector('[data-out]'),n=f.querySelector('[data-note]');
    function run(){
      var ac=parseFloat(a.value),mv=parseFloat(v.value),rt=parseFloat(r.value)/100;
      if(!(ac>0)||!(mv>0)||!(rt>0)){o.textContent='Enter acres and value';n.textContent='Compared with being taxed at full market value.';return;}
      var mid=ac*Math.max(0,mv-150)*rt;
      if(mid<100){o.textContent='Under $100 a year';n.textContent='At this size and value the difference is small.';return;}
      var lo=nice(mid*0.75,false), hi=nice(mid*1.25,true);
      if(hi<=lo) hi=lo+(lo>=2000?500:100);
      o.textContent=money(lo)+' to '+money(hi)+' a year';
      n.textContent='A rough range, not a quote. Your appraisal district\'s values decide the real number.';
    }
    [a,v,r].forEach(function(x){x.addEventListener('input',run);});
  });
})();
</script>
